# PromptMate 后端环境变量配置模板
# 复制此文件为 .env 并填入实际值

# 服务器端口
PORT=8787

# Supabase 配置
# 从 Supabase Dashboard -> Settings -> API 获取
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# CORS 配置（允许的前端域名，逗号分隔）
# 开发环境
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# 生产环境示例
# CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# 审计日志管理密钥（可选）
AUDIT_ADMIN_SECRET=your-secret-key-here

# OAuth 提供商配置
# 这些配置在 Vercel 环境变量中设置

# Google OAuth 配置
# 从 Google Cloud Console 获取
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth 配置
# 从 GitHub Settings -> Developer settings -> OAuth Apps 获取
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# LinuxDo OAuth 配置
# 从 Linux.do OAuth 应用管理页面获取
LINUXDO_CLIENT_ID=your-linuxdo-client-id
LINUXDO_CLIENT_SECRET=your-linuxdo-client-secret

# 测试环境配置
NODE_ENV=development


