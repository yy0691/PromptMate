{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020", "DOM"],
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "skipLibCheck": true,
    "outDir": "dist-server",
    "rootDir": "server",
    "types": ["node"],
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false
  },
  "include": ["server/**/*.ts"]
}
